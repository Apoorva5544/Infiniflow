# ── Required ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Security (change to a long random string in production) ───────────────────
JWT_SECRET=change-this-super-secret-key-in-production

# ── Database (SQLite default, swap for PostgreSQL in prod) ────────────────────
# Production example (Neon):
#   DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# When DATABASE_URL points at PostgreSQL, the API uses a connection pool (pool_pre_ping).
DATABASE_URL=sqlite:///./backend/infiniflow.db

# ── Redis (used by Celery for async task queue + semantic cache backend) ──────
# The semantic cache automatically uses Redis when REDIS_URL is set (Upstash:
#   REDIS_URL=rediss://default:token@xxx.upstash.io:6379
# ) and falls back to an in-process in-memory cache otherwise.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=rediss://default:your_token@your-region.upstash.io:6379
# UPSTASH_REDIS_REST_URL=https://your-region.upstash.io

# ── Vector Store (chroma | pgvector) ───────────────────────────────────────────
# Production: set VECTOR_STORE=pgvector — embeddings live in PostgreSQL
# (Neon) and queries use ANN via the pgvector HNSW index. Requires DATABASE_URL.
VECTOR_STORE=chroma
CHROMA_PATH=./chroma_db

# ── Reranker ───────────────────────────────────────────────────────────────────
# Enables cross-encoder reranking after hybrid retrieval (vector + BM25).
# Falls back to top-k truncation automatically if the model cannot be loaded.
ENABLE_RERANKER=true
RERANKER_TOP_K=5

# ── Optional ───────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# SENTRY_DSN=https://...
# LOG_LEVEL=INFO
